{
  "name": "hisobkor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "release": "node scripts/release.mjs",
    "dev:cloud": "wrangler dev --var ENVIRONMENT:local",
    "build:cloud": "npm run build && wrangler deploy --dry-run --outdir dist-worker",
    "deploy:cloud": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next-themes": "^0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "4.134.0"
  },
  "description": "Hisobkor.uz — buxgalter ish maydoni",
  "engines": {
    "node": ">=24"
  }
}
