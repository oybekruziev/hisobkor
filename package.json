{
  "name": "hisobkor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "release": "node scripts/release.mjs",
    "dev:cloud": "wrangler dev --var ENVIRONMENT:local",
    "build:cloud": "npm run build && wrangler deploy --dry-run --outdir dist-worker",
    "deploy:cloud": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3",
    "wrangler": "4.134.0"
  },
  "description": "Hisobkor.uz — buxgalter ish maydoni",
  "engines": {
    "node": ">=24"
  }
}
